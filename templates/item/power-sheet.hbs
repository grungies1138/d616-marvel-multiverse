<div class="power-sheet">
  <header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" />
    <input name="name" type="text" value="{{item.name}}" placeholder="Power Name" {{#unless editable}}disabled{{/unless}} />
  </header>

  <div class="form-grid">
    <label>{{localize "D616.Sheet.PowerSet"}}
      <input type="text" name="system.powerSet" value="{{system.powerSet}}" {{#unless editable}}disabled{{/unless}} />
    </label>
    <label>{{localize "D616.Sheet.Prerequisites"}}
      <input type="text" name="system.prerequisites" value="{{system.prerequisites}}" {{#unless editable}}disabled{{/unless}} />
    </label>

    <label>{{localize "D616.Sheet.Action"}}
      <select name="system.action" {{#unless editable}}disabled{{/unless}}>
        <option value="standard" {{#if (eq system.action "standard")}}selected{{/if}}>{{localize "D616.Action.standard"}}</option>
        <option value="move" {{#if (eq system.action "move")}}selected{{/if}}>{{localize "D616.Action.move"}}</option>
        <option value="reaction" {{#if (eq system.action "reaction")}}selected{{/if}}>{{localize "D616.Action.reaction"}}</option>
        <option value="passive" {{#if (eq system.action "passive")}}selected{{/if}}>{{localize "D616.Action.passive"}}</option>
        <option value="free" {{#if (eq system.action "free")}}selected{{/if}}>{{localize "D616.Action.free"}}</option>
      </select>
    </label>
    <label>{{localize "D616.Sheet.Duration"}}
      <input type="text" name="system.duration" value="{{system.duration}}" {{#unless editable}}disabled{{/unless}} />
    </label>
    <label>{{localize "D616.Sheet.Range"}}
      <input type="text" name="system.range" value="{{system.range}}" {{#unless editable}}disabled{{/unless}} />
    </label>

    <fieldset>
      <legend>{{localize "D616.Sheet.Cost"}}</legend>
      <label>Flat Focus
        <input type="number" name="system.cost.flat" value="{{system.cost.flat}}" min="0" {{#unless editable}}disabled{{/unless}} />
      </label>
      <label class="checkbox">
        <input type="checkbox" name="system.cost.scales" {{#if system.cost.scales}}checked{{/if}} {{#unless editable}}disabled{{/unless}} />
        {{localize "D616.Sheet.ScalingCost"}}
      </label>
      <label>{{localize "D616.Sheet.ScalingRatio"}}
        <input type="number" name="system.cost.ratio" value="{{system.cost.ratio}}" min="1" {{#unless editable}}disabled{{/unless}} />
      </label>
      <label>{{localize "D616.Sheet.ScalingMinimum"}}
        <input type="number" name="system.cost.minimum" value="{{system.cost.minimum}}" min="0" {{#unless editable}}disabled{{/unless}} />
      </label>
    </fieldset>

    <fieldset>
      <legend>Attack Roll</legend>
      <label class="checkbox">
        <input type="checkbox" name="system.attack.enabled" {{#if system.attack.enabled}}checked{{/if}} {{#unless editable}}disabled{{/unless}} />
        This power makes an attack/check roll
      </label>
      <label>{{localize "D616.Sheet.AttackAbility"}}
        <select name="system.attack.ability" {{#unless editable}}disabled{{/unless}}>
          {{#each abilities}}
          <option value="{{this}}" {{#if (eq ../system.attack.ability this)}}selected{{/if}}>{{localize (concat "D616.Ability." this)}}</option>
          {{/each}}
        </select>
      </label>
      <label>{{localize "D616.Sheet.DefenseTargeted"}}
        <select name="system.attack.defenseTarget" {{#unless editable}}disabled{{/unless}}>
          {{#each abilities}}
          <option value="{{this}}" {{#if (eq ../system.attack.defenseTarget this)}}selected{{/if}}>{{localize (concat "D616.Ability." this)}} Defense</option>
          {{/each}}
          <option value="flat" {{#if (eq system.attack.defenseTarget "flat")}}selected{{/if}}>Flat Target Number</option>
        </select>
      </label>
      <label>{{localize "D616.Sheet.FlatDC"}}
        <input type="number" name="system.attack.flatDC" value="{{system.attack.flatDC}}" {{#unless editable}}disabled{{/unless}} />
      </label>
      <label class="checkbox">
        <input type="checkbox" name="system.attack.dealsDamage" {{#if system.attack.dealsDamage}}checked{{/if}} {{#unless editable}}disabled{{/unless}} />
        {{localize "D616.Sheet.DealsDamage"}}
      </label>
      <label>{{localize "D616.Sheet.DamageType"}}
        <select name="system.attack.damageType" {{#unless editable}}disabled{{/unless}}>
          <option value="health" {{#if (eq system.attack.damageType "health")}}selected{{/if}}>{{localize "D616.Sheet.Health"}}</option>
          <option value="focus" {{#if (eq system.attack.damageType "focus")}}selected{{/if}}>{{localize "D616.Sheet.Focus"}}</option>
        </select>
      </label>
      <label>{{localize "D616.Sheet.FantasticEffect"}}
        <input type="text" name="system.attack.fantasticEffect" value="{{system.attack.fantasticEffect}}" {{#unless editable}}disabled{{/unless}} />
      </label>
    </fieldset>

    <fieldset>
      <legend>{{localize "D616.Sheet.PassiveBonus"}}</legend>
      <label class="checkbox">
        <input type="checkbox" name="system.passive.enabled" {{#if system.passive.enabled}}checked{{/if}} {{#unless editable}}disabled{{/unless}} />
        Always-on passive bonus
      </label>
      <label>{{localize "D616.Sheet.BonusAbility"}}
        <select name="system.passive.ability" {{#unless editable}}disabled{{/unless}}>
          {{#each abilities}}
          <option value="{{this}}" {{#if (eq ../system.passive.ability this)}}selected{{/if}}>{{localize (concat "D616.Ability." this)}}</option>
          {{/each}}
        </select>
      </label>
      <label>{{localize "D616.Sheet.DamageMultiplierBonus"}}
        <input type="number" name="system.passive.damageMultiplierBonus" value="{{system.passive.damageMultiplierBonus}}" {{#unless editable}}disabled{{/unless}} />
      </label>
      <label>{{localize "D616.Sheet.DamageModifierBonus"}}
        <input type="number" name="system.passive.damageModifierBonus" value="{{system.passive.damageModifierBonus}}" {{#unless editable}}disabled{{/unless}} />
      </label>
      <label>{{localize "D616.Sheet.NonAttackCheckBonus"}}
        <input type="number" name="system.passive.nonAttackCheckBonus" value="{{system.passive.nonAttackCheckBonus}}" {{#unless editable}}disabled{{/unless}} />
      </label>
      <label>{{localize "D616.Sheet.HealthDRBonus"}}
        <input type="number" name="system.passive.healthDamageReductionBonus" value="{{system.passive.healthDamageReductionBonus}}" min="0" {{#unless editable}}disabled{{/unless}} />
      </label>
      <label>{{localize "D616.Sheet.DefenseBonus"}}
        <input type="number" name="system.passive.defenseBonus" value="{{system.passive.defenseBonus}}" min="0" {{#unless editable}}disabled{{/unless}} />
      </label>
      <label>{{localize "D616.Sheet.StandingEdgeOn"}}
        <select name="system.passive.standingEdgeOn" {{#unless editable}}disabled{{/unless}}>
          <option value="" {{#if (eq system.passive.standingEdgeOn "")}}selected{{/if}}>{{localize "D616.Roll.None"}}</option>
          <option value="initiative" {{#if (eq system.passive.standingEdgeOn "initiative")}}selected{{/if}}>{{localize "D616.Sheet.Initiative"}}</option>
          <option value="attacks" {{#if (eq system.passive.standingEdgeOn "attacks")}}selected{{/if}}>{{localize "D616.Sheet.AllAttacks"}}</option>
          {{#each abilities}}
          <option value="{{this}}" {{#if (eq ../system.passive.standingEdgeOn this)}}selected{{/if}}>{{localize (concat "D616.Ability." this)}}</option>
          {{/each}}
        </select>
      </label>
    </fieldset>

    <label class="full-width">{{localize "D616.Sheet.Effect"}}
      <textarea name="system.effect" rows="6" {{#unless editable}}disabled{{/unless}}>{{system.effect}}</textarea>
    </label>
  </div>
</div>
