<div class="d616-roll-card {{#if isFantastic}}fantastic{{/if}}">
  <header class="roll-card-header">
    <strong>{{title}}</strong>
    {{#if subtitle}}<span class="roll-card-sub">{{subtitle}}</span>{{/if}}
  </header>

  {{#if (ne total null)}}
  <div class="roll-card-dice">
    <img class="die-icon" src="{{concat 'systems/d616/icons/d6-white-' d1 '.svg'}}" alt="{{d1}}" />
    {{#if isFantastic}}
    <img class="die-icon marvel-die-icon" src="systems/d616/icons/d6-marvel-star.svg" alt="Fantastic" />
    {{else}}
    <img class="die-icon marvel-die-icon" src="{{concat 'systems/d616/icons/d6-marvel-' rawMarvel '.svg'}}" alt="{{marvelValue}}" />
    {{/if}}
    <img class="die-icon" src="{{concat 'systems/d616/icons/d6-white-' d2 '.svg'}}" alt="{{d2}}" />
    <span class="plus">+</span>
    <span class="ability-bonus">{{abilityValue}}</span>
    <span class="equals">=</span>
    <span class="roll-total">{{total}}</span>
  </div>
  {{/if}}

  {{#if isFantastic}}
  <p class="callout fantastic-callout">{{localize "D616.Roll.Fantastic"}}{{#if fantasticEffect}} — {{fantasticEffect}}{{/if}}</p>
  {{/if}}

  {{#if defenseTargetLabel}}
  <p class="roll-vs">{{localize "D616.Roll.vs"}} {{defenseTargetLabel}} (compare to the target's value)</p>
  {{/if}}
  {{#if targetNumber}}
  <p class="roll-vs">{{localize "D616.Roll.vs"}} {{targetNumber}} &mdash;
    {{#if success}}<strong class="success">{{localize "D616.Roll.Success"}}</strong>{{else}}<strong class="failure">{{localize "D616.Roll.Failure"}}</strong>{{/if}}
  </p>
  {{/if}}

  {{#if targetName}}
  <p class="roll-target">{{localize "D616.Roll.Target"}}: <strong>{{targetName}}</strong>{{#if drApplied}} &middot; {{localize "D616.Roll.DRApplied"}}: {{drApplied}}{{/if}}{{#if damageType}} &middot; {{localize (concat "D616.Roll.DamageType." damageType)}}{{/if}}</p>
  {{/if}}

  {{#if damage}}
  <p class="roll-damage"><strong>{{localize "D616.Roll.Damage"}}: {{damage}}</strong></p>
  {{/if}}

  {{#if teamRerollNote}}
  <p class="roll-target">{{teamRerollNote}}</p>
  {{/if}}

  {{#if extraNote}}
  <p class="roll-target">{{extraNote}}</p>
  {{/if}}

  {{#if helperNote}}
  <p class="roll-damage"><strong>{{helperNote}}</strong></p>
  {{/if}}

  {{#if knockbackNote}}
  <p class="callout fantastic-callout">{{knockbackNote}}</p>
  {{/if}}

  {{#if rolledDamageNote}}
  <p class="roll-target">{{localize "D616.Damage.Rolled"}}: {{rolledDamageNote}}</p>
  {{/if}}
  {{#if canRollDamage}}
  <div class="roll-damage-actions">
    <button type="button" class="edge-trouble-btn" data-action="d616RollDamage">{{localize "D616.Damage.RollButton"}} ({{damageFormula}})</button>
  </div>
  {{/if}}

  {{#if canApplyDamage}}
  {{#if damageNotApplied}}<p class="roll-target">{{localize "D616.Damage.NotAppliedHint"}}</p>{{/if}}
  {{#if staleApplied}}<p class="roll-target">{{localize "D616.Damage.StaleHint"}}</p>{{/if}}
  <div class="roll-damage-actions">
    <button type="button" class="edge-trouble-btn" data-action="d616ApplyDamage" data-tooltip="{{localize 'D616.Damage.ApplyHint'}}">{{localize "D616.Damage.Apply"}}</button>
    <button type="button" class="edge-trouble-btn trouble" data-action="d616UndoDamage" data-tooltip="{{localize 'D616.Damage.UndoHint'}}">{{localize "D616.Damage.Undo"}}</button>
  </div>
  {{/if}}

  {{#if focusCost}}
  <p class="roll-cost">Spent {{focusCost}} Focus</p>
  {{/if}}

  {{#if healed}}
  <p class="roll-damage"><strong>{{localize "D616.Karma.Healed"}}: {{healed}}</strong></p>
  {{/if}}

  {{#if (ne total null)}}{{#unless noEdgeTrouble}}
  <div class="roll-edge-trouble">
    {{#if (eq edgeTroubleApplied "none")}}
    <button type="button" class="edge-trouble-btn edge" data-action="d616ApplyEdge">{{localize "D616.Roll.AddEdge"}}</button>
    <button type="button" class="edge-trouble-btn trouble" data-action="d616ApplyTrouble">{{localize "D616.Roll.AddTrouble"}}</button>
    <button type="button" class="edge-trouble-btn edge karma" data-action="d616KarmaEdge">{{localize "D616.Karma.SpendForEdgeBtn"}}</button>
    {{#if targetName}}
    <button type="button" class="edge-trouble-btn trouble karma" data-action="d616KarmaTrouble">{{localize "D616.Karma.SpendForTroubleBtn"}}</button>
    {{/if}}
    {{else}}
    <span class="edge-trouble-tag {{edgeTroubleApplied}}">
      {{#if (eq edgeTroubleApplied "edge")}}{{localize "D616.Roll.EdgeApplied"}}{{else}}{{localize "D616.Roll.TroubleApplied"}}{{/if}}
    </span>
    {{/if}}
  </div>
  {{/unless}}{{/if}}
</div>
