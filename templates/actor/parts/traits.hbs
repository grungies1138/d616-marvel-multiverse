<section class="tab {{#if traitsActive}}active{{/if}}" data-tab="traits">

  {{#if editable}}
  <a class="add-item" data-action="addTrait"><i class="fa-solid fa-plus"></i> {{localize "D616.Sheet.AddTrait"}}</a>
  {{/if}}

  <div class="mm-styled-container">
    <h3>{{localize "D616.Sheet.Tabs.traits"}}</h3>
    <div class="mm-styled-container-body">
      {{#if traits.length}}
      <ul class="item-list">
        {{#each traits}}
        <li class="mm-item" data-item-id="{{this.id}}">
          <img class="item-img" src="{{this.img}}" />
          <div class="item-name">
            <span>{{this.name}}</span>
            {{#if this.situation}}<span class="item-subtitle">{{this.situation}}</span>{{/if}}
          </div>
          <div class="item-controls">
            <a data-action="useTrait" title="Post to chat"><i class="fa-solid fa-comment"></i></a>
            {{#if ../editable}}
            <a data-action="editItem" title="{{localize 'D616.Sheet.EditItem'}}"><i class="fa-solid fa-pen"></i></a>
            <a data-action="deleteItem" title="{{localize 'D616.Sheet.DeleteItem'}}"><i class="fa-solid fa-trash"></i></a>
            {{/if}}
          </div>
        </li>
        {{/each}}
      </ul>
      {{else}}
      <p class="hint">{{localize "D616.Sheet.NoTraits"}}</p>
      {{/if}}
    </div>
  </div>

</section>
