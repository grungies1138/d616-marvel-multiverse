<section class="tab {{#if gearActive}}active{{/if}}" data-tab="gear">

  {{#if editable}}
  <a class="add-item" data-action="addGear"><i class="fa-solid fa-plus"></i> {{localize "D616.Sheet.AddGear"}}</a>
  {{/if}}

  <div class="mm-styled-container">
    <h3>{{localize "D616.Sheet.Tabs.gear"}}</h3>
    <div class="mm-styled-container-body">
      {{#if gear.length}}
      <ul class="item-list">
        {{#each gear}}
        <li class="mm-item" data-item-id="{{this.id}}" data-tooltip="{{{this.tooltip}}}" data-tooltip-direction="UP">
          <img class="item-img" src="{{this.img}}" />
          <div class="item-name">
            <span>{{this.name}}</span>
            <span class="item-subtitle">{{this.categoryLabel}}</span>
          </div>
          {{#if this.costLabel}}<span class="item-tag">{{this.costLabel}}</span>{{/if}}
          <div class="item-controls">
            <a data-action="useGear" title="{{#if this.isAttack}}{{localize 'D616.Sheet.UseGear'}}{{else}}{{localize 'D616.Sheet.EditItem'}}{{/if}}">
              <i class="fa-solid {{#if this.isAttack}}fa-dice-d6{{else}}fa-comment{{/if}}"></i>
            </a>
            {{#if ../editable}}
            <a data-action="editItem" title="{{localize 'D616.Sheet.EditItem'}}"><i class="fa-solid fa-pen"></i></a>
            <a data-action="deleteItem" title="{{localize 'D616.Sheet.DeleteItem'}}"><i class="fa-solid fa-trash"></i></a>
            {{/if}}
          </div>
        </li>
        {{/each}}
      </ul>
      {{else}}
      <p class="hint">{{localize "D616.Sheet.NoGear"}}</p>
      {{/if}}
    </div>
  </div>

</section>
