<header class="sheet-header">
  <a class="d616-theme-toggle" data-action="toggleTheme" title="{{localize 'D616.Sheet.ToggleTheme'}}">
    <i class="fa-solid {{#if themeDark}}fa-sun{{else}}fa-moon{{/if}}"></i>
  </a>
  <div class="mm-hero-portrait-block">
    <div class="mm-hero-portrait">
      <img src="{{actor.img}}" data-action="editImage" title="{{actor.name}}" />
    </div>
    <div class="mm-rank-block">
      <label class="mm-label">{{localize "D616.Sheet.Rank"}}</label>
      <input type="number" name="system.rank" value="{{system.rank}}" min="1" max="6" {{#unless editable}}disabled{{/unless}} />
    </div>
    <div class="mm-karma-block">
      <label class="mm-label">{{localize "D616.Sheet.Karma"}}</label>
      <input type="number" name="system.karma.value" value="{{system.karma.value}}" {{#unless editable}}disabled{{/unless}} />
    </div>
  </div>

  <div class="header-fields">
    <div class="mm-styled-field -fill">
      <label class="mm-styled-label"><span>{{localize "D616.Sheet.Codename"}}</span></label>
      <div class="mm-styled-input">
        <input name="name" type="text" value="{{actor.name}}" placeholder="Codename" {{#unless editable}}disabled{{/unless}} />
      </div>
    </div>

    <div class="mm-stat-row">
      <div class="mm-stat-block">
        <label class="mm-label">{{localize "D616.Sheet.Health"}}</label>
        <div class="mm-input mm-fraction">
          <input type="number" class="mm-fraction-num" name="system.health.value" value="{{system.health.value}}" {{#unless editable}}disabled{{/unless}} />
          <span class="mm-fraction-bar"></span>
          <span class="mm-fraction-den">{{system.health.max}}</span>
        </div>
        <div class="mm-stat-corner-block">
          <label class="mm-label">DR</label>
          <div class="mm-input">
            <input type="number" name="system.health.damageReduction" value="{{system.health.damageReduction}}" {{#unless editable}}disabled{{/unless}} />
          </div>
        </div>
      </div>

      <div class="mm-stat-block -focus">
        <label class="mm-label">{{localize "D616.Sheet.Focus"}}</label>
        <div class="mm-input mm-fraction">
          <input type="number" class="mm-fraction-num" name="system.focus.value" value="{{system.focus.value}}" {{#unless editable}}disabled{{/unless}} />
          <span class="mm-fraction-bar"></span>
          <span class="mm-fraction-den">{{system.focus.max}}</span>
        </div>
      </div>

      <div class="mm-stat-block">
        <label class="mm-label">{{localize "D616.Sheet.Speed"}} / {{localize "D616.Sheet.Initiative"}}</label>
        <div class="mm-input">
          <span class="mm-input-line">{{system.speed}}</span>
          <span class="mm-input-line">
            {{initiativeDisplay}}
            <a data-action="rollInitiative" title="{{localize 'D616.Roll.Initiative'}}"><i class="fa-solid fa-dice-d6"></i></a>
          </span>
        </div>
      </div>
    </div>
  </div>
</header>
