<section class="tab {{#if powersActive}}active{{/if}}" data-tab="powers">

  {{#if editable}}
  <a class="add-item" data-action="addPower"><i class="fa-solid fa-plus"></i> {{localize "D616.Sheet.AddPower"}}</a>
  {{/if}}

  <div class="mm-styled-container">
    <h3>{{localize "D616.Sheet.Tabs.powers"}}</h3>
    <div class="mm-styled-container-body">
      {{#if powers.length}}
      <ul class="item-list">
        {{#each powers}}
        <li class="mm-item" data-item-id="{{this.id}}" data-tooltip="{{{this.tooltip}}}" data-tooltip-direction="UP">
          <img class="item-img" src="{{this.img}}" />
          <div class="item-name">
            <span>{{this.name}}</span>
            {{#if this.powerSet}}<span class="item-subtitle">{{this.powerSet}}</span>{{/if}}
          </div>
          <span class="item-tag">{{this.actionLabel}}</span>
          <span class="item-tag">{{this.costLabel}}</span>
          <div class="item-controls">
            <a data-action="usePower" title="{{localize 'D616.Sheet.UsePower'}}"><i class="fa-solid fa-dice-d6"></i></a>
            {{#if ../editable}}
            <a data-action="editItem" title="{{localize 'D616.Sheet.EditItem'}}"><i class="fa-solid fa-pen"></i></a>
            <a data-action="deleteItem" title="{{localize 'D616.Sheet.DeleteItem'}}"><i class="fa-solid fa-trash"></i></a>
            {{/if}}
          </div>
        </li>
        {{/each}}
      </ul>
      {{else}}
      <p class="hint">{{localize "D616.Sheet.NoPowers"}}</p>
      {{/if}}
    </div>
  </div>

</section>
